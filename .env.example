# enkay.dev — required & optional environment variables.
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets to the repo.

# REQUIRED — Resend API key for the contact form (app/api/contact/route.ts).
# Without this, POST /api/contact returns 503 and new leads are silently dropped.
RESEND_API_KEY=

# OPTIONAL — DeepSeek API key for AI-personalized auto-replies on the contact form.
# Falls back to a default reply when missing.
DEEPSEEK_API_KEY=
